<?xml version="1.0" encoding="utf-8"?>
<!--
  Foreground: a keyboard keycap carrying a geometric "Ấ" — white key tile
  with a darker bottom lip, blue/violet glyph, orange sắc tick. Reads as
  "Vietnamese keyboard" at launcher size.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- shadow under the keycap -->
    <path
        android:fillColor="#33000000"
        android:pathData="M30,79.5a24,4.4 0 1,0 48,0a24,4.4 0 1,0 -48,0z" />

    <!-- keycap bottom lip -->
    <path
        android:fillColor="#AEB9DE"
        android:pathData="M41,37.5h26a10,10 0 0 1 10,10v22a10,10 0 0 1 -10,10h-26a10,10 0 0 1 -10,-10v-22a10,10 0 0 1 10,-10z" />

    <!-- keycap face -->
    <path android:pathData="M41,34h26a10,10 0 0 1 10,10v22a10,10 0 0 1 -10,10h-26a10,10 0 0 1 -10,-10v-22a10,10 0 0 1 10,-10z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="34"
                android:endX="54"
                android:endY="76">
                <item android:color="#FFFFFF" android:offset="0" />
                <item android:color="#E3E9F9" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- "Ấ": A legs + crossbar -->
    <path
        android:strokeWidth="6.4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M54,44.5 L43.5,69 M54,44.5 L64.5,69 M47.6,62 L60.4,62">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="43.5"
                android:startY="44.5"
                android:endX="64.5"
                android:endY="69">
                <item android:color="#2563EB" android:offset="0" />
                <item android:color="#7C3AED" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- circumflex -->
    <path
        android:strokeWidth="5.4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeColor="#4F46E5"
        android:pathData="M47.8,39.5 L54,34.2 L60.2,39.5" />

    <!-- sắc tick -->
    <path
        android:strokeWidth="4.8"
        android:strokeLineCap="round"
        android:pathData="M64,31 L69.5,25.5">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="64"
                android:startY="31"
                android:endX="69.5"
                android:endY="25.5">
                <item android:color="#FBBF24" android:offset="0" />
                <item android:color="#F97316" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
