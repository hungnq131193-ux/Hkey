<?xml version="1.0" encoding="utf-8"?>
<!--
  Foreground: a keyboard keycap carrying a geometric "Ấ" — white key tile
  with a darker bottom lip, blue/violet glyph, orange sắc tick. Reads as
  "Vietnamese keyboard" at launcher size.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- shadow under the keycap -->
    <path
        android:fillColor="#33000000"
        android:pathData="M31,80a23,4 0 1,0 46,0a23,4 0 1,0 -46,0z" />

    <!-- keycap bottom lip -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M40,36h5a4,4 0 0 1 4,4v22a4,4 0 0 1 -4,4h-5a4,4 0 0 1 -4,-4v-22a4,4 0 0 1 4,-4z" />

    <!-- keycap face -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M63,36h5a4,4 0 0 1 4,4v22a4,4 0 0 1 -4,4h-5a4,4 0 0 1 -4,-4v-22a4,4 0 0 1 4,-4z" />

    <!-- "Ấ": A legs + crossbar -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M44,48h20a3,3 0 0 1 3,3v2a3,3 0 0 1 -3,3h-20a3,3 0 0 1 -3,-3v-2a3,3 0 0 1 3,-3z" />

    <!-- circumflex -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M40,70h6a2,2 0 0 1 2,2v3a2,2 0 0 1 -2,2h-6a2,2 0 0 1 -2,-2v-3a2,2 0 0 1 2,-2z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M51,70h6a2,2 0 0 1 2,2v3a2,2 0 0 1 -2,2h-6a2,2 0 0 1 -2,-2v-3a2,2 0 0 1 2,-2z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M62,70h6a2,2 0 0 1 2,2v3a2,2 0 0 1 -2,2h-6a2,2 0 0 1 -2,-2v-3a2,2 0 0 1 2,-2z" />

    <!-- sắc tick -->
    <path android:pathData="M67,30h7a3,3 0 0 1 3,3v3a3,3 0 0 1 -3,3h-7a3,3 0 0 1 -3,-3v-3a3,3 0 0 1 3,-3z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="64"
                android:startY="30"
                android:endX="77"
                android:endY="39">
                <item android:color="#8FF5E8" android:offset="0" />
                <item android:color="#2DD4BF" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
