<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HKey"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Bộ gõ Telex thông minh tự học ngữ cảnh"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_enable_ime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="1. Kích hoạt HKey trong Cài đặt" />

        <Button
            android:id="@+id/btn_pick_ime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="2. Chọn HKey làm bàn phím" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="24dp"
            android:background="#3C4043" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cài đặt bàn phím"
            android:textSize="18sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/sw_vibrate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Rung khi gõ" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/sw_sound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Âm thanh phím" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Kiểu gõ"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/sp_method"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/sw_tone_new"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Bỏ dấu kiểu mới (hoà, thuỷ)" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/sw_spell_check"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Kiểm tra chính tả trước khi áp dấu" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/sw_number_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Hàng số phía trên" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/sw_double_space"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Hai lần cách → dấu chấm" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Giao diện"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/sp_theme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Kiểu phím"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/sp_shape"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Mô tả giao diện"
            android:textStyle="bold" />

        <com.hkey.app.ui.ThemePreviewView
            android:id="@+id/theme_preview"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Gõ tắt (mỗi dòng: ký-tự=nội-dung, vd: hn=Hà Nội)"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/ed_macros"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="#2A2D31"
            android:hint="hn=Hà Nội"
            android:importantForAutofill="no"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:padding="8dp"
            android:textColorHint="#80868B" />

        <TextView
            android:id="@+id/tv_height_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Chiều cao phím: 100%" />

        <SeekBar
            android:id="@+id/sb_height"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="60" />

        <TextView
            android:id="@+id/tv_side_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Thu hẹp 2 bên: 0dp" />

        <SeekBar
            android:id="@+id/sb_side"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="24" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Đổi xong mở lại bàn phím để áp dụng."
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="24dp"
            android:background="#3C4043" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quyền riêng tư"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="HKey học cách gõ của bạn để gợi ý tốt hơn. Dữ liệu chỉ lưu trên máy, không gửi đi đâu, và tự tắt trong ô mật khẩu/email/URL."
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_clear_learning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Xóa dữ liệu học" />

        <TextView
            android:id="@+id/tv_learning_cleared"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
