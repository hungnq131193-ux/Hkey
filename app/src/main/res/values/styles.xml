<resources>
    <style name="KbKey">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginHorizontal">2dp</item>
        <item name="android:layout_marginVertical">3dp</item>
        <item name="android:background">@drawable/key_bg</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/kb_text</item>
        <item name="android:textSize">19sp</item>
    </style>

    <style name="KbKey.Func">
        <item name="android:background">@drawable/key_bg_func</item>
        <item name="android:textSize">18sp</item>
    </style>
</resources>
